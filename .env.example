# SocratiQ configuration. Copy to `.env` (never commit real values).
# Every name below is read by the code (backend/app/config.py, ai/config.py, ai/rag/config.py, frontend/src/lib/*).
# Required = the backend refuses to start (production) or the feature fails without it.

# ---------------------------------------------------------------- Core
ENVIRONMENT=development                 # "production" turns on strict validation (explicit CORS, Supabase, no local storage)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/socratiq        # REQUIRED. Postgres 16 + pgvector
POSTGRES_PASSWORD=CHANGE_ME             # docker-compose only (REQUIRED there)
CORS_ORIGINS=http://localhost:5173      # comma-separated explicit origins; '*' is rejected in production
PUBLIC_API_URL=http://localhost:8000    # how browsers reach the API (used for file links and the frontend build)

# ---------------------------------------------------------------- Auth + file storage (Supabase)
SUPABASE_URL=                           # REQUIRED in production (Auth). Project URL
SUPABASE_SERVICE_ROLE_KEY=              # REQUIRED in production. SERVER ONLY: never put this in a VITE_* variable
SUPABASE_ANON_KEY=                      # frontend build arg (public by design) -> VITE_SUPABASE_ANON_KEY
SUPABASE_BUCKET=                        # storage bucket for uploads (STORAGE_BUCKET also accepted)
STORAGE_BACKEND=                        # "supabase" (default when SUPABASE_* set) or "local" (development only)
LOCAL_STORAGE_DIR=                      # local storage path (development only)
FILE_LINK_SECRET=                       # REQUIRED in production: HMAC key for download links (e.g. `openssl rand -hex 32`)

# ---------------------------------------------------------------- Frontend build (frontend/.env or build args)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- AI provider (one global provider, or per role)
# Roles: COACH, REASONING, LIGHTWEIGHT, VERIFICATION. If any AI_<ROLE>_* variable is set for a role, that role uses the
# role-specific settings; otherwise the global AI_* settings below apply.
AI_PROVIDER=openai                      # see ai/config.py for the supported providers
AI_API_KEY=                             # REQUIRED for the chosen provider
AI_BASE_URL=                            # required for OpenAI-compatible endpoints
AI_MODEL_DEFAULT=
# AI_COACH_PROVIDER= / AI_COACH_API_KEY= / AI_COACH_BASE_URL= / AI_MODEL_COACH=      (same pattern for REASONING, LIGHTWEIGHT, VERIFICATION)
AI_TIMEOUT=
AI_MAX_RETRIES=
AI_RATE_LIMIT_PER_MINUTE=10             # per student, shared by /ai/coach and /ai/coach/stream (per process)
COACH_HISTORY_WINDOW=10

# ---------------------------------------------------------------- RAG (pgvector + embeddings + reranker)
NVIDIA_API_KEY=                         # used by the NVIDIA embedding and reranker providers
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIM=2048                  # MUST equal the database column vector(2048); changing it needs a migration
RAG_RERANKER_PROVIDER=nvidia
RAG_RERANKER_BASE_URL=
RAG_RERANKER_MODEL=
RAG_DENSE_TOP_K=
RAG_FTS_TOP_K=
RAG_RERANK_TOP_K=
RUN_INGEST_WORKER=true                  # in-process document ingestion worker
